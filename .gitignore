# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# surowe nagrania klientow (z dzwiekiem) - zrodla dla npm run wideo, tylko lokalnie
/wideo-zrodla/

# lekkie wersje zdjec poradnikow - powstaja przy kazdym buildzie (scripts/obrazy-blog.mjs)
/public/images/opt/blog/
/src/data/obrazy-blog.json
